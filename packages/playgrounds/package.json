{
  "name": "@graphoria/playgrounds",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:graphiql": "bun ./graphiql/index.html",
    "dev:scalar": "bun ./scalar/index.html",
    "dev:console": "bun ./console/index.html",
    "type-check": "tsc -p tsconfig.json && tsc -p tsconfig.build.json",
    "build": "bun run type-check && bun build.ts",
    "build:graphiql": "bun run type-check && bun build.ts graphiql",
    "build:scalar": "bun run type-check && bun build.ts scalar",
    "build:console": "bun run type-check && bun build.ts console"
  },
  "dependencies": {
    "@graphiql/toolkit": "1.0.1",
    "@scalar/api-reference": "^1.77.0",
    "graphiql": "6.0.1",
    "graphql": "17.1.0",
    "graphql-ws": "^6.4.1",
    "monaco-editor": "0.57.0",
    "monaco-graphql": "2.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3"
  }
}
