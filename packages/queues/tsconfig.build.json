{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "./dist",
    "paths": {
      "@graphoria/server": ["../server/dist/src/index.d.ts"]
    }
  },
  "include": ["src/**/*", "package.json"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
